# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/gabi-fashion-store
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gabi-fashion-store
MONGO_URI=mongodb://127.0.0.1:27017/gabi-fashion-store

# Port the API listens on.
PORT=8080

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
